{
  "manifest_version": 3,
  "name": "Agent X Browser Bridge",
  "version": "2.0.0",
  "description": "Connect Agent X AI to exact browser tabs, full YouTube control and basic web actions (search, click a result, read, fill a field).",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "nativeMessaging",
    "bookmarks",
    "history",
    "sessions"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/browser-extension/setup.html*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Agent X Browser Bridge",
    "default_popup": "popup.html"
  }
}
