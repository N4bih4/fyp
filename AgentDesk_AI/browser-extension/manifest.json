{
  "manifest_version": 3,
  "name": "Agent X Browser Bridge",
  "version": "1.0.0",
  "description": "Connect Agent X AI to exact browser tabs and YouTube pause/resume controls.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*", "https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Agent X: click to reconnect"}
}
